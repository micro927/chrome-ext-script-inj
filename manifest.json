{
  "manifest_version": 3,
  "name": "Script Injector",
  "version": "1.1",
  "description": "Inject custom scripts into websites with group management and auto-fire control",
  "minimum_chrome_version": "135",
  "permissions": [
    "storage",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Script Injector"
  },
  "background": {
    "service_worker": "background.js"
  }
}
